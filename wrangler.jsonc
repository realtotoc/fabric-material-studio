{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fabric-material-studio",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "STUDIO_USER": "admin"
  }
}
